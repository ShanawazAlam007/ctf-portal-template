# ============================================================
# CTF PORTAL TEMPLATE — ENVIRONMENT CONFIGURATION
# ============================================================
# Copy this file to .env and adjust parameters for your event.
# NEVER commit the actual .env file to public version control!
# ============================================================

# Application Environment
APP_NAME=CyberArenaCTF
PORTAL_BASE_URL=http://localhost
SECRET_KEY=generate_a_secure_random_64_character_hex_string_here
FORCE_HTTPS=false

# PostgreSQL Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ctf_db
POSTGRES_USER=ctf_admin
POSTGRES_PASSWORD=replace_with_a_secure_database_password

# Master Administrator Initialization (Used only on initial setup)
ADMIN_NAME=CTF Director
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_admin_passphrase

# Access & Registration Controls
# Comma-separated domains e.g. example.edu,university.ac.in (Leave blank to permit any domain)
ALLOWED_EMAIL_DOMAINS=
# Set true if usernames must strictly be numeric roll numbers
REQUIRE_NUMERIC_ROLL=false
# Set true to require manual administrator approval before newly registered participants can log in
REQUIRE_ADMIN_APPROVAL=true
# Set true to lock stages sequentially (Stage N requires Stage N-1 flags), or false for open jeopardy
SEQUENTIAL_STAGES=true

# Transactional Email (SMTP) Configuration (Optional)
# If left blank, email verification links will be logged directly to the server console/logs
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply@example.com
SMTP_USE_TLS=true

# Rate Limiting & Anti-Brute-Force
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=30
RATE_LIMIT_FLAG_WINDOW=2
